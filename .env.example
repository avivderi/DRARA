# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# ─── Database (PostgreSQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drara_dev
DB_USER=drara
DB_PASSWORD=drara_dev_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ─────────────────────────────────────────
# Run: npm run keys:generate (from apps/api)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# ─── OAuth — Google ───────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── OAuth — GitHub ───────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
# Scopes needed for Module 2 (GitHub scanning)
GITHUB_SCOPE=user:email,read:user

# ─── QR Session Linking ───────────────────────────────────
QR_SESSION_TTL_SECONDS=120

# ─── Web App (Next.js) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ─── GitHub App (Module 2) ───────────────────────────────
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_NAME=drara-app
GITHUB_PRIVATE_KEY_PATH=./keys/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# ─── AI Service & Feature Flags (Module 2) ────────────────
GITHUB_AI_SCAN_ENABLED=true
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=your_claude_api_key
MAX_SCANS_PER_DAY=5

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
